# Kopieren nach .env.local und mit echten Werten befüllen.
# Siehe README.md, Abschnitt "ENV-Variablen & Mailversand".

RESEND_API_KEY=
CONTACT_TO_EMAIL=info@sv-fisch.de
MAIL_FROM="SV Fisch Website <formular@sv-fisch.de>"
NEXT_PUBLIC_FANSHOP_URL=https://www.spreadshirt.de/

# Newsletter über Brevo (Paris, DSGVO-konform, AVV im Konto).
