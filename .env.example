# Kopieren nach .env.local und mit echten Werten befüllen.
# Siehe README.md, Abschnitt "ENV-Variablen & Mailversand".

RESEND_API_KEY=
CONTACT_TO_EMAIL=info@sv-fisch.de
MAIL_FROM="SV Fisch Website <formular@sv-fisch.de>"
NEXT_PUBLIC_FANSHOP_URL=https://www.spreadshirt.de/

# Newsletter über Brevo (Paris, DSGVO-konform, AVV im Konto).
# Ohne diese drei Werte lehnt die Anmeldung ab, statt still auf den alten
# Weg zurückzufallen. Siehe app/api/newsletter/route.ts.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=

# Instagram, Beitraege des Vereinskontos auf der Startseite.
# Die Anbindung ist NOCH NICHT gebaut, nur die Schluesselverwaltung.
#
# Der Schluessel gilt 60 Tage, danach ist er tot und laesst sich nicht mehr
# verlaengern. Erneuern mit:  npm run instagram:token
# Der Waechter im Bau meldet ab 14 Tagen Restlaufzeit.
#
# Das Datum ist kein Beiwerk: Ohne es kann niemand sagen, wann Schluss ist.
INSTAGRAM_TOKEN=
INSTAGRAM_TOKEN_ERNEUERT_AM=
